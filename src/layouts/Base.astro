---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Emi Higgins — software engineer. Project archive and notes.' } =
  Astro.props;

const siteName = 'emi.higgins';
const pageTitle = title ? `${title} — ${siteName}` : siteName;

const nav = [
  { href: '/projects/', label: 'projects' },
  { href: '/log/', label: 'log' },
  { href: '/about/', label: 'about' },
  { href: '/now/', label: 'now' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="emi.higgins — log"
      href="/rss.xml"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <p class="wordmark">
        <a href="/">{siteName}</a>
        <span class="fill" aria-hidden="true"
          >══════════════════════════════════════════════════════════════════════</span
        >
      </p>
      <nav class="nav" aria-label="Main">
        {
          nav.map((item, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </>
          ))
        }
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <p class="fill" aria-hidden="true">
        ──────────────────────────────────────────────────────────────────────
      </p>
      <p>
        <a href="https://github.com/emihiggins">github</a> ·
        <a href="/rss.xml">rss</a>
      </p>
    </footer>
  </body>
</html>
