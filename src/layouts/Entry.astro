---
import Base from './Base.astro';
import { isoDate } from '../lib/entries';

interface Props {
  title: string;
  date: Date;
  summary: string;
  status?: string;
  /** Blueprints only — the project being rebuilt. */
  project?: string;
  /** Blueprints only — rough wall-clock time to work through it. */
  time?: string;
  stack?: string[];
  links?: { label: string; url: string }[];
  tags?: string[];
  /** Where the original lives, if this is a copy (log posts from dev.to). */
  canonical?: string;
  backHref: string;
  backLabel: string;
}

const {
  title,
  date,
  summary,
  status,
  project,
  time,
  stack = [],
  links = [],
  tags = [],
  canonical,
  backHref,
  backLabel,
} = Astro.props;
---

<Base title={title} description={summary} canonical={canonical}>
  <h1>{title}</h1>

  <div class="meta">
    <dl>
      <dt>date</dt>
      <dd><time datetime={date.toISOString()}>{isoDate(date)}</time></dd>

      {status && <dt>status</dt>}
      {status && <dd>{status}</dd>}

      {project && <dt>rebuilds</dt>}
      {project && <dd>{project}</dd>}

      {time && <dt>time</dt>}
      {time && <dd>{time}</dd>}

      {stack.length > 0 && <dt>stack</dt>}
      {stack.length > 0 && <dd>{stack.join(', ')}</dd>}

      {tags.length > 0 && <dt>tags</dt>}
      {tags.length > 0 && <dd>{tags.join(', ')}</dd>}

      {links.length > 0 && <dt>links</dt>}
      {
        links.length > 0 && (
          <dd>
            {links.map((link, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <a href={link.url}>{link.label}</a>
              </>
            ))}
          </dd>
        )
      }
    </dl>
  </div>

  <hr />

  <slot />

  <hr />

  <p><a href={backHref}>&larr; {backLabel}</a></p>
</Base>
