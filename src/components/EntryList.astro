---
import { yearMonth } from '../lib/entries';

export interface Row {
  date: Date;
  kind?: 'proj' | 'log';
  title: string;
  href: string;
  summary?: string;
  /** Stack items for a project, topics for a post. Rendered as chips. */
  tags?: string[];
}

interface Props {
  rows: Row[];
  /** Show the [proj] / [log] marker next to the date. */
  showKind?: boolean;
  /** Show the one-line summary under each title. */
  showSummary?: boolean;
  /** Show the stack/topic chips under each summary. */
  showTags?: boolean;
  empty?: string;
}

const {
  rows,
  showKind = false,
  showSummary = false,
  showTags = false,
  empty = 'Nothing here yet.',
} = Astro.props;
---

{
  rows.length === 0 ? (
    <p class="section-label">{empty}</p>
  ) : (
    <ul class="entries">
      {rows.map((row) => (
        <li class="entry">
          <span class="entry-meta">
            <time class="entry-date" datetime={row.date.toISOString()}>
              {yearMonth(row.date)}
            </time>
            {showKind && row.kind && <span class="entry-kind">[{row.kind}]</span>}
          </span>
          <span class="entry-title">
            <a href={row.href}>{row.title}</a>
          </span>
          {showSummary && row.summary && <span class="entry-summary">{row.summary}</span>}
          {showTags && row.tags && row.tags.length > 0 && (
            <ul class="entry-tags">
              {row.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  )
}
