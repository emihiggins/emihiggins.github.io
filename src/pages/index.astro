---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { getProjectsByKind, getPosts, projectRow } from '../lib/entries';

const RECENT = 3;

const [{ oss, side }, posts] = await Promise.all([getProjectsByKind(), getPosts()]);

const ossRows = oss.slice(0, RECENT).map(projectRow);
const sideRows = side.slice(0, RECENT).map(projectRow);

const postRows = posts.slice(0, RECENT).map((p) => ({
  date: p.data.date,
  title: p.data.title,
  href: `/log/${p.id}/`,
  summary: p.data.summary,
}));
---

<Base>
  <p>
    Hi! welcome to my site!
  </p>
  <p>
    This is an archive: side projects, random musings blog, ideas, and things I think are fun
  </p>

  <h2>Side Projects</h2>

  <EntryList rows={sideRows} showSummary={true} empty="No side projects yet." />

  <h2>Open Source</h2>

  <EntryList rows={ossRows} showSummary={true} empty="No open source projects yet." />

  {(oss.length > RECENT || side.length > RECENT) && (
    <a class="more" href="/projects/">all projects →</a>
  )}

  <h2>Log</h2>

  <EntryList rows={postRows} showSummary={true} empty="No posts yet." />

  {posts.length > RECENT && <a class="more" href="/log/">all posts →</a>}
</Base>
