---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getProjects } from '../../lib/entries';

const rows = (await getProjects()).map((p) => ({
  date: p.data.date,
  title: p.data.title,
  href: `/projects/${p.id}/`,
  summary: p.data.summary,
}));
---

<Base title="projects" description="Projects Emi Higgins has built.">
  <h1>Projects</h1>
  <p>Things I've built and shipped, newest first.</p>
  <EntryList rows={rows} showSummary={true} empty="No projects published yet." />
</Base>
