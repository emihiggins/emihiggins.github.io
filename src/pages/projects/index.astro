---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getProjectsByKind, projectRow } from '../../lib/entries';

const { oss, research, side } = await getProjectsByKind();
---

<Base title="projects" description="Projects Emi Higgins has built.">
  <h1>Projects</h1>
  <p>Things I've built and shipped, newest first.</p>

  <h2>Side Projects</h2>
  <EntryList
    rows={side.map(projectRow)}
    showSummary={true}
    showTags={true}
    empty="No side projects published yet."
  />

  <h2>Open Source</h2>

  <h3 class="subsection">Research &amp; Tools</h3>
  <EntryList
    rows={research.map(projectRow)}
    showSummary={true}
    showTags={true}
    empty="No research published yet."
  />

  <h3 class="subsection">Projects</h3>
  <EntryList
    rows={oss.map(projectRow)}
    showSummary={true}
    showTags={true}
    empty="No open source projects published yet."
  />
</Base>
