---
import type { GetStaticPaths } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import Entry from '../../layouts/Entry.astro';
import { getPosts } from '../../lib/entries';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props as Props;
const { Content } = await render(post);
---

<Entry
  title={post.data.title}
  date={post.data.date}
  summary={post.data.summary}
  tags={post.data.tags}
  links={[{ label: 'dev.to', url: post.data.url }]}
  canonical={post.data.canonical}
  backHref="/log/"
  backLabel="all posts"
>
  <div class="devto-body">
    <Content />
  </div>
  <p><a href={post.data.url}>Comments and reactions on dev.to &rarr;</a></p>
</Entry>
